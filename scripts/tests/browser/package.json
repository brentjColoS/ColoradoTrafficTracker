{
  "name": "colorado-traffic-tracker-browser-tests",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=mobile-chromium",
    "test:api": "playwright test --config=playwright.api.config.ts",
    "test:capacity": "node capacity/run.cjs",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "test:smoke": "playwright test specs/smoke.spec.ts --project=chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
