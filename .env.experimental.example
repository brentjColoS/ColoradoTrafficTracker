# Copy to .env.experimental in the experimental worktree and chmod 600.
# Never reuse the production database owner or commit the populated file.
EXPERIMENT_DB_USERNAME=traffic_dashboard_reader
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-read-only-password
EXPERIMENT_API_SECURITY_KEYS=replace-with-a-separate-long-random-api-key

# Existing production resources. The sidecar joins this network but does not
# create, restart, or own the production database or ingestion services.
PRODUCTION_DOCKER_NETWORK=coloradotraffictracker_default
PRODUCTION_DB_HOST=traffic-db
PRODUCTION_POSTGRES_DB=traffic

# Loopback-only upstream consumed by Caddy.
EXPERIMENT_DASHBOARD_PORT=8083
EXPERIMENT_API_RATE_LIMIT_REQUESTS_PER_MINUTE=120
EXPERIMENT_MEMORY_LIMIT=1536m
EXPERIMENT_CPU_LIMIT=1.5
EXPERIMENT_PIDS_LIMIT=128
