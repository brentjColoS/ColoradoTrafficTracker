POSTGRES_USER=traffic
POSTGRES_PASSWORD=traffic
POSTGRES_DB=traffic
PGHOST_PORT=5432
HOST_BIND_ADDRESS=127.0.0.1
TOMTOM_API_KEY=replace-with-your-tomtom-key
# Leave disabled until the second account's dashboard confirms its allowance has reset.
TOMTOM_SECONDARY_API_KEY=
TOMTOM_SECONDARY_ENABLED=false
CDOT_API_KEY=replace-with-your-cdot-key
CDOT_BASE_URL=https://data.cotrip.org
TRAFFIC_MODE=tile
TRAFFIC_FLOW_PROVIDER=tomtom
TRAFFIC_FLOW_ENABLED=true
TRAFFIC_FLOW_POLL_SECONDS=125
TRAFFIC_FLOW_TILE_ZOOM=10
TRAFFIC_INCIDENT_PROVIDER=cdot
TRAFFIC_INCIDENTS_ENABLED=true
TRAFFIC_INCIDENT_POLL_SECONDS=900
TRAFFIC_INCIDENT_TILE_ZOOM=9
TRAFFIC_MONTHLY_REQUEST_TARGET=190000
TRAFFIC_MONTHLY_REQUEST_HARD_STOP=195000
TRAFFIC_MONTHLY_REQUEST_ALLOWANCE=200000
# Compatibility settings for point mode and pre-refactor deployments.
# Tile-mode flow uses the monthly limits above.
TRAFFIC_POLL_SECONDS=60
TRAFFIC_STARTUP_VALIDATION_ENABLED=true
TRAFFIC_TILE_ZOOM=11
TRAFFIC_TILE_CONCURRENCY=4
TRAFFIC_TILE_ROUTE_BUFFER_METERS=500
TRAFFIC_TILE_QUOTA_TARGET_DAILY_REQUESTS=45000
TRAFFIC_TILE_QUOTA_ADAPTIVE_CAP_DAILY_REQUESTS=45000
TRAFFIC_TILE_QUOTA_HARD_STOP_DAILY_REQUESTS=45000
TRAFFIC_HTTP_CONNECT_TIMEOUT_SECONDS=3
TRAFFIC_HTTP_RESPONSE_TIMEOUT_SECONDS=10
TRAFFIC_RETENTION_ENABLED=true
TRAFFIC_RETENTION_DAYS=30
TRAFFIC_OBS_INGEST_GAP_MINUTES=15
TRAFFIC_OBS_QUOTA_WARN_PERCENT=80
TRAFFIC_OBS_QUOTA_CRITICAL_PERCENT=95
TRAFFIC_OBS_PROVIDER_NULL_CYCLE_THRESHOLD=3
TRAFFIC_OBS_PROVIDER_STALE_CYCLE_THRESHOLD=30
TRAFFIC_OBS_PROVIDER_RECOVERY_PROBE_SECONDS=60
TRAFFIC_TIMESERIES_ENABLED=true
TRAFFIC_TIMESERIES_CREATE_HYPERTABLES=true
TRAFFIC_TIMESERIES_ENABLE_COMPRESSION=true
TRAFFIC_TIMESERIES_CREATE_CONTINUOUS_AGGREGATES=true
TRAFFIC_TIMESERIES_COMPRESSION_AFTER_DAYS=7
API_SECURITY_ENABLED=true
API_SECURITY_KEYS=dev-local-key
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=120
API_RATE_LIMIT_TRUST_FORWARDED_FOR=false
DASHBOARD_PUBLIC_DATA_ENABLED=true
SPRING_PROFILES_ACTIVE=
COMPOSE_HEALTH_WATCHDOG_SERVICES=api-service ingest-service routes-service
COMPOSE_HEALTH_WATCHDOG_INTERVAL_SECONDS=30
COMPOSE_HEALTH_WATCHDOG_FAILURES=3
COMPOSE_HEALTH_WATCHDOG_COOLDOWN_SECONDS=180
COMPOSE_HEALTH_WATCHDOG_MAX_CHECKS=0
